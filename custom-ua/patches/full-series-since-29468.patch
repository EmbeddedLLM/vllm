+            assert e_score_correction_bias is not None, (
+                "DeepSeekV3 routing requires e_score_correction_bias"
+            )
+            score_mode = "sigmoid"
+        else:
+            score_mode = None
         return aiter_triton_kernel_w4a16_moe_forward(
             hidden_states=hidden_states,
             w1=w1,
